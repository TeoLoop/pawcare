# ==============================================================================
# Kira Care - Variables de Entorno (.env.example)
# Copiá este archivo a .env.local para configurar tus credenciales locales.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Base de datos PostgreSQL, Autenticación y RLS)
# ------------------------------------------------------------------------------
# [PÚBLICAS] Expuestas al navegador de forma segura con políticas RLS
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# [PRIVADA / SERVIDOR EXCLUSIVO] NUNCA exponer al cliente. Usado únicamente por
# servicios del servidor para webhooks de Meta y workers de background con validación estricta.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. WhatsApp Business Platform Cloud API (Oficial de Meta)
# ------------------------------------------------------------------------------
# [PRIVADA / SERVIDOR EXCLUSIVO] Token de acceso del Sistema de Meta Business Platform
WHATSAPP_API_TOKEN=your-meta-system-user-or-temp-access-token

# [PRIVADA / SERVIDOR EXCLUSIVO] ID del número telefónico de WhatsApp registrado en Meta Developers
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id

# [PRIVADA / SERVIDOR EXCLUSIVO] ID de la cuenta comercial de WhatsApp (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id

# [PRIVADA / SERVIDOR EXCLUSIVO] Token secreto elegido por vos para verificar el Webhook en Meta
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_secure_custom_verify_token_here

# [PRIVADA / SERVIDOR EXCLUSIVO] App Secret de la app de Meta para verificar la firma X-Hub-Signature-256
META_APP_SECRET=your_meta_app_secret_here

# [PRIVADA / SERVIDOR EXCLUSIVO] Nombre de la plantilla aprobada en WhatsApp (opcional, si se usa fuera de ventana 24h)
WHATSAPP_REMINDER_TEMPLATE_NAME=kira_medication_reminder

# ------------------------------------------------------------------------------
# 3. Configuración de la Aplicación y Seguridad
# ------------------------------------------------------------------------------
# [PÚBLICA] URL base de la aplicación (utilizada para generar enlaces seguros de confirmación de dosis)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [PRIVADA / SERVIDOR EXCLUSIVO] Token secreto para proteger el endpoint cron de envío de recordatorios
CRON_SECRET=generate_a_random_32_char_secret_for_cron_jobs

# [PÚBLICA / CONFIG] Zona horaria por defecto
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Montevideo
