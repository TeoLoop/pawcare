# ==============================================================================
# PawCare - Variables de Entorno (.env.example)
# Copiá este archivo a .env.local para configurar tus credenciales locales.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Base de datos PostgreSQL, Autenticación y RLS)
# ------------------------------------------------------------------------------
# [PÚBLICAS] Expuestas al navegador de forma segura con políticas RLS
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# [PRIVADA / SERVIDOR EXCLUSIVO] NUNCA exponer al cliente. Clave de servicio para el servidor.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Recordatorios de WhatsApp (Sin cuenta de empresa en Meta)
# ------------------------------------------------------------------------------
# No requiere verificación de empresa ni configuración en Meta Developers.
# 1. Enlaces directos (wa.me): Funcionan automáticamente sin ninguna variable de entorno.
# 2. CallMeBot API (opcional para bot personal automático):
#    Podés configurar tu API key personal directamente en Ajustes de la app.

# ------------------------------------------------------------------------------
# 3. Configuración de la Aplicación y Seguridad
# ------------------------------------------------------------------------------
# [PÚBLICA] URL base de la aplicación (para enlaces de confirmación y WhatsApp)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [PRIVADA / SERVIDOR EXCLUSIVO] Token secreto para proteger el endpoint cron de recordatorios
CRON_SECRET=generate_a_random_32_char_secret_for_cron_jobs

# [PÚBLICA / CONFIG] Zona horaria por defecto
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Montevideo
